{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signal.v1",
  "title": "AlphaStreet signal, version 1",
  "description": "One row of signals.v1.jsonl (the event, once). Fields this pack cannot fill yet are null, never missing.",
  "type": "object",
  "required": ["signal_id", "schema_version", "source_kind", "source_name", "source_url", "author", "author_id", "source_reliability",
               "engagement", "parent_id", "thread_position", "scope", "detector", "subtype", "title", "title_original", "language",
               "summary", "region", "country", "subject_issuer_id", "ticker", "event_direction", "strength", "confidence",
               "materiality", "novelty", "horizon_days", "half_life_days", "event_at", "published_at", "detected_at", "valid_until",
               "cluster_id", "evidence", "details", "producer", "model", "prompt_version", "signal_type", "superseded_by",
               "superseded_at", "backfilled"],
  "properties": {
    "signal_id": {"type": "string"},
    "schema_version": {"const": 1},
    "source_kind": {"enum": ["social_post", "long_form", "news_article", "regulatory_filing", "exchange_disclosure", "government_document", "data_release", "market_data"]},
    "source_name": {"type": "string"},
    "source_url": {"type": "string"},
    "author": {"type": ["string", "null"]},
    "author_id": {"type": ["string", "null"]},
    "source_reliability": {"type": "number", "minimum": 0, "maximum": 1},
    "engagement": {"type": ["object", "null"]},
    "parent_id": {"type": ["string", "null"]},
    "thread_position": {"type": ["integer", "null"]},
    "scope": {"enum": ["company", "sector", "theme", "market", "macro", "policy", "geopolitical"]},
    "detector": {"type": "string"},
    "subtype": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "title_original": {"type": ["string", "null"]},
    "language": {"type": "string", "pattern": "^[a-z]{2}$"},
    "summary": {"type": ["string", "null"]},
    "region": {"type": "string"},
    "country": {"type": ["string", "null"]},
    "subject_issuer_id": {"type": ["string", "null"]},
    "ticker": {"type": ["string", "null"]},
    "event_direction": {"enum": [-1, 0, 1, null]},
    "strength": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "materiality": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "novelty": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "horizon_days": {"type": ["integer", "null"]},
    "half_life_days": {"type": ["number", "null"]},
    "event_at": {"type": ["string", "null"], "format": "date-time"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "detected_at": {"type": ["string", "null"], "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "cluster_id": {"type": "string"},
    "evidence": {"type": ["string", "null"]},
    "details": {
      "type": "object",
      "description": "Typed per detector. news: publisher, entities, matched_issuers.",
      "required": ["publisher", "entities", "matched_issuers"],
      "additionalProperties": false,
      "properties": {
        "publisher": {"type": "string"},
        "entities": {"type": ["array", "null"]},
        "matched_issuers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "producer": {"type": "string"},
    "model": {"type": ["string", "null"]},
    "prompt_version": {"type": ["string", "null"]},
    "signal_type": {"enum": ["event", "state"]},
    "superseded_by": {"type": ["string", "null"]},
    "superseded_at": {"type": ["string", "null"], "format": "date-time"},
    "backfilled": {"type": "boolean"},
    "_ocn": {"type": "object", "description": "Provenance from OCN; not part of the contract"}
  },
  "additionalProperties": false,
  "$defs": {
    "impact": {
      "title": "One row of signal_impacts.v1.jsonl (signal x affected company)",
      "type": "object",
      "required": ["signal_id", "issuer_id", "link_type", "link_hops", "direction", "exposure", "exposure_source", "link_confidence"],
      "additionalProperties": false,
      "properties": {
        "signal_id": {"type": "string"},
        "issuer_id": {"type": "string"},
        "link_type": {"enum": ["direct", "supplier", "customer", "competitor", "peer", "sector", "macro"]},
        "link_hops": {"type": "integer", "minimum": 0},
        "direction": {"enum": [-1, 0, 1, null]},
        "exposure": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "exposure_source": {"type": "string"},
        "link_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
