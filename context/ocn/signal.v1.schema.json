{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signal.v1.1",
  "title": "AlphaStreet signal, version 1.1",
  "description": "One row of signals.v1.jsonl (the event, once). Fields this pack cannot fill yet are null, never missing. v1.1 adds signal_detection, category and details.matched_in_title, and widens the impact key to include link_type; all additive to v1. Social-post fields (author, author_id, engagement, parent_id, thread_position) are removed until the pack has social sources.",
  "type": "object",
  "required": [
    "signal_id",
    "schema_version",
    "source_kind",
    "source_name",
    "source_url",
    "source_reliability",
    "scope",
    "detector",
    "subtype",
    "signal_detection",
    "category",
    "title",
    "title_original",
    "language",
    "summary",
    "region",
    "country",
    "subject_issuer_id",
    "ticker",
    "event_direction",
    "strength",
    "confidence",
    "materiality",
    "novelty",
    "horizon_days",
    "half_life_days",
    "event_at",
    "published_at",
    "detected_at",
    "valid_until",
    "cluster_id",
    "evidence",
    "details",
    "producer",
    "model",
    "prompt_version",
    "signal_type",
    "superseded_by",
    "superseded_at",
    "backfilled"
  ],
  "properties": {
    "signal_id": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "source_kind": {
      "enum": [
        "social_post",
        "long_form",
        "news_article",
        "regulatory_filing",
        "exchange_disclosure",
        "government_document",
        "data_release",
        "market_data"
      ]
    },
    "source_name": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_reliability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "scope": {
      "enum": [
        "company",
        "sector",
        "theme",
        "market",
        "macro",
        "policy",
        "geopolitical"
      ]
    },
    "detector": {
      "enum": [
        "news",
        "taiwan",
        "korea",
        "japan",
        "china",
        "middle_east",
        "geo",
        "macro",
        "sec",
        "social"
      ]
    },
    "subtype": {
      "type": "string"
    },
    "signal_detection": {
      "enum": [
        "signal",
        "weak_signal",
        "noise"
      ],
      "description": "Relevance label. Rule-based in this pack until OCN's classifier grades the rows; the rule is named in evidence"
    },
    "category": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Topics: this pack's keyword topics (ipo, funding, earnings, pricing, product, demand, supply, competition, talent, legal, regulation, export_controls, geopolitics, momentum) plus OCN's own impacted categories. The longest half-life prior among them sets half_life_days"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "title_original": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": "string"
    },
    "country": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_issuer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "ticker": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_direction": {
      "enum": [
        -1,
        0,
        1,
        null
      ]
    },
    "strength": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "materiality": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "novelty": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "horizon_days": {
      "type": [
        "integer",
        "null"
      ]
    },
    "half_life_days": {
      "type": [
        "number",
        "null"
      ]
    },
    "event_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "detected_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "cluster_id": {
      "type": "string"
    },
    "evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "type": "object",
      "description": "Typed per detector: every detector has publisher, entities, matched_issuers, matched_in_title, plus its own keys (see allOf).",
      "required": [
        "publisher",
        "entities",
        "matched_issuers",
        "matched_in_title"
      ],
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "type": "string"
        },
        "entities": {
          "type": [
            "array",
            "null"
          ]
        },
        "matched_issuers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matched_in_title": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The issuers named in the headline, a subset of matched_issuers"
        },
        "local_code": {},
        "source_category": {},
        "revenue_deviation_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "clause_label": {},
        "stock_code": {},
        "report_type": {},
        "typical_direction": {},
        "signal_type": {},
        "link_direction": {},
        "affected_companies": {
          "type": "array"
        },
        "effect": {
          "enum": [
            "good",
            "bad",
            "mixed",
            null
          ]
        },
        "channel": {},
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series_id": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transmission": {},
        "z_score": {
          "type": [
            "number",
            "object",
            "null"
          ]
        },
        "move_bp": {
          "type": [
            "number",
            "object",
            "null"
          ]
        }
      }
    },
    "producer": {
      "type": "string"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "signal_type": {
      "enum": [
        "event",
        "state"
      ]
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "superseded_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "backfilled": {
      "type": "boolean"
    },
    "_ocn": {
      "type": "object",
      "description": "Provenance from OCN; not part of the contract"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "impact": {
      "title": "One row of signal_impacts.v1.jsonl. Key: (signal_id, issuer_id, link_type), so one company can be linked more than one way",
      "type": "object",
      "required": [
        "signal_id",
        "issuer_id",
        "link_type",
        "link_hops",
        "direction",
        "exposure",
        "exposure_source",
        "link_confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "signal_id": {
          "type": "string"
        },
        "issuer_id": {
          "type": "string"
        },
        "link_type": {
          "enum": [
            "direct",
            "supplier",
            "customer",
            "competitor",
            "peer",
            "sector",
            "macro"
          ]
        },
        "link_hops": {
          "type": "integer",
          "minimum": 0
        },
        "direction": {
          "enum": [
            -1,
            0,
            1,
            null
          ]
        },
        "exposure": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "exposure_source": {
          "type": "string"
        },
        "link_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "detector": {
            "const": "news"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "publisher",
              "entities",
              "matched_issuers",
              "matched_in_title"
            ],
            "propertyNames": {
              "enum": [
                "publisher",
                "entities",
                "matched_issuers",
                "matched_in_title"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "detector": {
            "const": "taiwan"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "publisher",
              "entities",
              "matched_issuers",
              "matched_in_title",
              "local_code",
              "source_category",
              "revenue_deviation_pct",
              "clause_label"
            ],
            "propertyNames": {
              "enum": [
                "publisher",
                "entities",
                "matched_issuers",
                "matched_in_title",
                "local_code",
                "source_category",
                "revenue_deviation_pct",
                "clause_label"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "detector": {
            "const": "korea"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "publisher",
              "entities",
              "matched_issuers",
              "matched_in_title",
              "stock_code",
              "report_type"
            ],
            "propertyNames": {
              "enum": [
                "publisher",
                "entities",
                "matched_issuers",
                "matched_in_title",
                "stock_code",
                "report_type"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "detector": {
            "const": "japan"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "publisher",
              "entities",
              "matched_issuers",
              "matched_in_title",
              "local_code",
              "source_category",
              "typical_direction"
            ],
            "propertyNames": {
              "enum": [
                "publisher",
                "entities",
                "matched_issuers",
                "matched_in_title",
                "local_code",
                "source_category",
                "typical_direction"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "detector": {
            "const": "china"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "publisher",
              "entities",
              "matched_issuers",
              "matched_in_title",
              "local_code",
              "signal_type",
              "link_direction"
            ],
            "propertyNames": {
              "enum": [
                "publisher",
                "entities",
                "matched_issuers",
                "matched_in_title",
                "local_code",
                "signal_type",
                "link_direction"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "detector": {
            "const": "middle_east"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "publisher",
              "entities",
              "matched_issuers",
              "matched_in_title",
              "affected_companies",
              "effect"
            ],
            "propertyNames": {
              "enum": [
                "publisher",
                "entities",
                "matched_issuers",
                "matched_in_title",
                "affected_companies",
                "effect"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "detector": {
            "const": "geo"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "publisher",
              "entities",
              "matched_issuers",
              "matched_in_title",
              "channel",
              "assets"
            ],
            "propertyNames": {
              "enum": [
                "publisher",
                "entities",
                "matched_issuers",
                "matched_in_title",
                "channel",
                "assets"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "detector": {
            "const": "macro"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "publisher",
              "entities",
              "matched_issuers",
              "matched_in_title",
              "series_id",
              "channel",
              "transmission",
              "z_score",
              "move_bp"
            ],
            "propertyNames": {
              "enum": [
                "publisher",
                "entities",
                "matched_issuers",
                "matched_in_title",
                "series_id",
                "channel",
                "transmission",
                "z_score",
                "move_bp"
              ]
            }
          }
        }
      }
    }
  ]
}
