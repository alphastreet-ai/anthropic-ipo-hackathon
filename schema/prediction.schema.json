{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anthropic IPO hackathon prediction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "method",
    "repo_url",
    "ipo_price",
    "day1_open",
    "day1_close",
    "day5_close",
    "thesis",
    "key_risks",
    "confidence"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "description": "your-handle/entry-name"
    },
    "method": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "description": "One line on how the prices were produced, e.g. 'LLM agent, claude-opus-5-5' or 'gradient boosting on IPO comps, Java'"
    },
    "repo_url": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 300,
      "description": "Link to the code that produced this file. Public, or private with read access for the judges (see RULES.md)"
    },
    "ipo_price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "median",
        "p10",
        "p90"
      ],
      "properties": {
        "median": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p10": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p90": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "Final IPO price per share, USD"
    },
    "day1_open": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "median",
        "p10",
        "p90"
      ],
      "properties": {
        "median": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p10": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p90": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "Opening price on the first trading day, USD"
    },
    "day1_close": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "median",
        "p10",
        "p90"
      ],
      "properties": {
        "median": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p10": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p90": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "Closing price on the first trading day, USD"
    },
    "day5_close": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "median",
        "p10",
        "p90"
      ],
      "properties": {
        "median": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p10": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p90": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "Closing price on the fifth trading day, USD"
    },
    "thesis": {
      "type": "string",
      "minLength": 50,
      "maxLength": 2500
    },
    "key_risks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 300
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Overall confidence in this set of calls"
    },
    "extra_predictions": {
      "type": "array",
      "maxItems": 10,
      "description": "Optional, not scored",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "by_date",
          "probability"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "maxLength": 300
          },
          "by_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
