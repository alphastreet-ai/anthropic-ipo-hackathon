{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anthropic IPO hackathon prediction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "models",
    "q1_ipo_price",
    "q2_above_range",
    "q3_upsized",
    "q4_day1_open",
    "q5_day1_close",
    "q6_close_above",
    "q7_close_nov30",
    "thesis",
    "key_risks",
    "confidence"
  ],
  "properties": {
    "agent": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "description": "your-handle/agent-name"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Model IDs the agent used"
    },
    "q1_ipo_price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "median",
        "p10",
        "p90"
      ],
      "properties": {
        "median": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p10": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p90": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "Final IPO price per share, USD. p10/p90 are your 80% range."
    },
    "q2_above_range": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "P(priced above the top of the last filed range)"
    },
    "q3_upsized": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "P(share count raised before pricing)"
    },
    "q4_day1_open": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "median",
        "p10",
        "p90"
      ],
      "properties": {
        "median": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p10": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p90": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "Opening price, first trading day"
    },
    "q5_day1_close": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "median",
        "p10",
        "p90"
      ],
      "properties": {
        "median": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p10": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p90": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "Closing price, first trading day"
    },
    "q6_close_above": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "P(day-one close above the IPO price)"
    },
    "q7_close_nov30": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "median",
        "p10",
        "p90"
      ],
      "properties": {
        "median": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p10": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p90": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "Closing price on Mon 30 Nov 2026"
    },
    "thesis": {
      "type": "string",
      "minLength": 50,
      "maxLength": 2500
    },
    "key_risks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 300
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Overall confidence in this set of calls"
    },
    "extra_predictions": {
      "type": "array",
      "maxItems": 10,
      "description": "Optional, not scored",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "by_date",
          "probability"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "maxLength": 300
          },
          "by_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
